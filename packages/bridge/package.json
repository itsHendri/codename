{
  "name": "codename-bridge",
  "version": "0.1.0",
  "description": "Local companion for the codename extension: stdio MCP to your agent, WebSocket on 127.0.0.1 to the panel.",
  "license": "MIT",
  "author": "Hendri van Niekerk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsHendri/codename.git",
    "directory": "packages/bridge"
  },
  "homepage": "https://github.com/itsHendri/codename/tree/main/packages/bridge#readme",
  "bugs": {
    "url": "https://github.com/itsHendri/codename/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design",
    "chrome-extension",
    "claude-code",
    "cursor",
    "design-tokens"
  ],
  "type": "module",
  "bin": {
    "codename-bridge": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
